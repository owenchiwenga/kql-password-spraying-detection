//
// Project 4: Password Spraying Detection and Investigation
// Language: Kusto Query Language (KQL)
// Purpose: Investigate potential password spraying patterns
//
// IMPORTANT:
// These queries require a table named SigninLogs with the
// relevant Microsoft Entra sign-in log columns.
// They will not run against the StormEvents sample dataset.

// Query 1: Review recent failed sign-ins
SigninLogs
| where TimeGenerated >= ago(24h)
| where ResultType != "0"
| project TimeGenerated, UserPrincipalName, IPAddress, ResultType, AppDisplayName
| order by TimeGenerated desc
| take 100

// Query 2: Count failed sign-ins by user and IP address
SigninLogs
| where TimeGenerated >= ago(24h)
| where ResultType != "0"
| summarize FailedAttempts = count() by UserPrincipalName, IPAddress
| order by FailedAttempts desc

// Query 3: Identify IP addresses associated with multiple accounts
SigninLogs
| where TimeGenerated >= ago(24h)
| where ResultType != "0"
| summarize
    FailedAttempts = count(),
    TargetedAccounts = dcount(UserPrincipalName)
    by IPAddress
| where TargetedAccounts >= 5
| order by TargetedAccounts desc, FailedAttempts desc

// Query 4: Review accounts targeted from multiple IP addresses
SigninLogs
| where TimeGenerated >= ago(24h)
| where ResultType != "0"
| summarize
    FailedAttempts = count(),
    SourceIPs = dcount(IPAddress)
    by UserPrincipalName
| where SourceIPs >= 3
| order by FailedAttempts desc
